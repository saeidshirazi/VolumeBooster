{
  "name": "volumebooster",
  "version": "0.4.2",
  "private": true,
  "type": "module",
  "description": "Local, open-source volume control for Chrome, Edge, Brave and Firefox",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/saeidshirazi/VolumeBooster.git"
  },
  "scripts": {
    "test": "node --test tests/*.test.js",
    "test:browser": "node tests/browser.mjs",
    "build": "node scripts/build.mjs",
    "build:all": "node scripts/build.mjs",
    "test:firefox": "node tests/firefox.mjs",
    "icons": "node scripts/icons.mjs",
    "package": "node scripts/package.mjs",
    "package:public": "node scripts/package.mjs --public",
    "verify:release": "node scripts/verify-release.mjs --public",
    "lint:firefox": "web-ext lint --source-dir dist-firefox --warnings-as-errors",
    "store:assets": "node scripts/store-assets.mjs"
  },
  "devDependencies": {
    "fflate": "^0.8.3",
    "playwright": "^1.65.0",
    "selenium-webdriver": "^4.51.0",
    "web-ext": "^10.8.0"
  }
}
